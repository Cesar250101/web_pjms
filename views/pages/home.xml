<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pj_home" name="PJMS — Home" key="web_pjms.pj_home" track="1">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'homepage'"/>
            <div id="wrap" class="pj-site">
                <t t-call="web_pjms.pj_header"/>
                <main class="oe_structure" id="oe_structure_pj_home_main">
                    <t t-call="web_pjms.s_pj_hero"/>
                    <t t-call="web_pjms.s_pj_trust_bar"/>
                    <t t-call="web_pjms.s_pj_featured"/>
                    <t t-call="web_pjms.s_pj_categories"/>
                    <t t-call="web_pjms.s_pj_sale"/>
                    <t t-call="web_pjms.s_pj_promo_banner"/>
                    <t t-call="web_pjms.s_pj_bestsellers"/>
                    <t t-call="web_pjms.s_pj_brands"/>
                    <t t-call="web_pjms.s_pj_newsletter"/>
                </main>
            </div>
        </t>
    </template>

    <!-- website.page se crea en post_init_hook para evitar que Odoo sobreescriba el key -->
</odoo>
