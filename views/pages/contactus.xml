<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override de la página /contactus con estilos y contenido PJMS -->
    <template id="pj_contactus_override"
              name="PJMS — Contact Us Override"
              inherit_id="website.contactus">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="pj-site">
                <main class="pj-contact-main oe_structure" id="oe_structure_pj_contactus">

                    <!-- Hero -->
                    <section class="pj-page-hero pj-contact-hero">
                        <div class="pj-page-hero-content">
                            <span class="pj-eyebrow is-accent">Estamos aquí</span>
                            <h1 class="pj-cat-title">Contacto</h1>
                        </div>
                    </section>

                    <!-- Cuerpo: formulario + info -->
                    <section class="pj-contact-section">
                        <div class="pj-contact-inner">

                            <!-- Formulario nativo de Odoo (/website/form/) -->
                            <div class="pj-contact-form-wrap">
                                <span class="pj-eyebrow">Envíanos un mensaje</span>
                                <div class="s_website_form"
                                     data-vcss="001"
                                     data-snippet="s_website_form">
                                    <div class="container">
                                        <form id="contactus_form"
                                              action="/website/form/"
                                              method="post"
                                              enctype="multipart/form-data"
                                              class="pj-contact-form o_mark_required"
                                              data-mark="*"
                                              data-model_name="mail.mail"
                                              data-success-mode="redirect"
                                              data-success-page="/contactus-thank-you"
                                              data-pre-fill="true">
                                            <span class="hidden"
                                                  data-for="contactus_form"
                                                  t-att-data-values="contactus_form_values"/>
                                            <div class="pj-form-row">
                                                <div class="pj-field">
                                                    <label for="pj_cu_name">Nombre completo <span class="s_website_form_mark">*</span></label>
                                                    <input id="pj_cu_name" type="text" name="name"
                                                           class="s_website_form_input"
                                                           placeholder="Tu nombre"
                                                           required="required"
                                                           data-fill-with="name"/>
                                                </div>
                                                <div class="pj-field">
                                                    <label for="pj_cu_email">Correo electrónico <span class="s_website_form_mark">*</span></label>
                                                    <input id="pj_cu_email" type="email" name="email_from"
                                                           class="s_website_form_input"
                                                           placeholder="tu@correo.cl"
                                                           required="required"
                                                           data-fill-with="email"/>
                                                </div>
                                            </div>
                                            <div class="pj-form-row">
                                                <div class="pj-field">
                                                    <label for="pj_cu_phone">Teléfono</label>
                                                    <input id="pj_cu_phone" type="tel" name="phone"
                                                           class="s_website_form_input"
                                                           placeholder="+56 9 XXXX XXXX"
                                                           data-fill-with="phone"/>
                                                </div>
                                                <div class="pj-field">
                                                    <label for="pj_cu_subject">Asunto <span class="s_website_form_mark">*</span></label>
                                                    <input id="pj_cu_subject" type="text" name="subject"
                                                           class="s_website_form_input"
                                                           placeholder="¿En qué te podemos ayudar?"
                                                           required="required"/>
                                                </div>
                                            </div>
                                            <div class="pj-form-row full">
                                                <div class="pj-field">
                                                    <label for="pj_cu_message">Mensaje</label>
                                                    <textarea id="pj_cu_message" name="description"
                                                              class="s_website_form_input"
                                                              rows="5"
                                                              placeholder="Escribe tu mensaje aquí..."/>
                                                </div>
                                            </div>
                                            <div class="pj-form-actions">
                                                <button type="submit" class="pj-btn pj-btn-primary">
                                                    Enviar mensaje
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- Info de contacto -->
                            <div class="pj-contact-info">
                                <span class="pj-eyebrow">Información</span>
                                <div class="pj-info-item">
                                    <span class="material-symbols-outlined">location_on</span>
                                    <div>
                                        <strong>Showroom</strong>
                                        <p>CasaCostanera Nivel 3<br/>Santiago, Chile</p>
                                    </div>
                                </div>
                                <div class="pj-info-item">
                                    <span class="material-symbols-outlined">schedule</span>
                                    <div>
                                        <strong>Horario</strong>
                                        <p>Lun – Sáb: 10:00 – 21:00</p>
                                    </div>
                                </div>
                                <div class="pj-info-item">
                                    <span class="material-symbols-outlined">mail</span>
                                    <div>
                                        <strong>Email</strong>
                                        <a href="mailto:hola@pjms.cl">hola@pjms.cl</a>
                                    </div>
                                </div>
                                <div class="pj-info-item">
                                    <span class="material-symbols-outlined">photo_camera</span>
                                    <div>
                                        <strong>Instagram</strong>
                                        <a href="https://instagram.com/pjms.cl" target="_blank">@pjms.cl</a>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </section>

                </main>
            </div>
        </xpath>
    </template>
</odoo>
