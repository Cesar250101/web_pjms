<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agrega el campo 'Tipo de cinta' al formulario de product.ribbon -->
    <record id="product_ribbon_form_tipo" model="ir.ui.view">
        <field name="name">product.ribbon.form.tipo</field>
        <field name="model">product.ribbon</field>
        <field name="inherit_id" ref="website_sale.product_ribbon_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='html']" position="before">
                <field name="tipo"/>
            </xpath>
        </field>
    </record>
</odoo>
